# 服务端口
PORT=3001

# OpenAI 兼容多模态大模型配置（留空则自动启用内置 Mock 演示模式）
# 示例 1（阿里云百炼 / 通义千问 VL）：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-vl-max-latest
#
# 示例 2（火山方舟 / 豆包视觉）：
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=ep-xxxxxxxx
#
# 示例 3（硅基流动 SiliconFlow）：
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-vl-max-latest

# 可选：免费版与 Pro 付费版模型分级（留空则均使用 LLM_MODEL）
# 例如免费用户用低价模型 qwen-vl-plus，付费用户用旗舰模型 qwen-vl-max-latest
LLM_FREE_MODEL=
LLM_PRO_MODEL=

# ========== 免费额度与防刷保护配置 ==========
# 新人一次性体验页数（配合每日 2 页 = 首日合计可用 10 页，足够跑通 1~2 批真实单据）
FREE_WELCOME_PAGES=8
# 每日刷新免费页数（不累计，次日重置）
FREE_DAILY_PAGES=2
# 全站每日免费通道总熔断上限（按 ¥0.01/页 算 ≈ 每天最多 ¥10 兜底，不影响已付费用户）
GLOBAL_DAILY_FREE_LIMIT=1000
# 单 IP 每日免费总页数上限（防抓包伪造 x-user-id 刷量，同时允许同公司 Wi-Fi 下约 3 位同事试用；付费额度不受限）
IP_DAILY_FREE_LIMIT=30

# 管理员密钥（用于调用 POST /api/admin/codes/generate 批量生成 Pro 激活码）
ADMIN_TOKEN=change-me-in-production
